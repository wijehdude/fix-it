# Required — server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-...
# A current cost-efficient chat model that supports Structured Outputs.
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional
# Requests per minute per IP, per serverless instance (default 120).
RATE_LIMIT_PER_MIN=120
# Maximum rows accepted per analysis (default 10000).
MAX_ROWS=10000
# If set, the UI asks for this code once per session and API routes require it.
ACCESS_CODE=
